<mxfile host="app.diagrams.net"><diagram name="five-forces" id="five-forces"><mxGraphModel dx="1400" dy="700" grid="0" page="0" pageWidth="1400" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;New entrants&lt;/b&gt;&lt;br&gt;Everyone can build&lt;br&gt;&lt;b&gt;&lt;span style=&quot;font-size:24px;color:#019546&quot;&gt;→ Be the one who answers for it&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#f0f8f0;strokeColor=#019546;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="540" height="130" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Rivalry&lt;/b&gt;&lt;br&gt;New rivals push incumbents down&lt;br&gt;&lt;b&gt;&lt;span style=&quot;font-size:24px;color:#FFFFFF&quot;&gt;→ Sell the result, not the code&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#019546;strokeColor=#2D6E2A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="175" width="540" height="140" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;Substitutes&lt;/b&gt;&lt;br&gt;The client builds it&lt;br&gt;&lt;b&gt;&lt;span style=&quot;font-size:24px;color:#019546&quot;&gt;→ Hold its data, history, workflow&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#f0f8f0;strokeColor=#019546;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="540" height="130" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;Suppliers&lt;/b&gt;&lt;br&gt;Two labs can switch you off&lt;br&gt;&lt;b&gt;&lt;span style=&quot;font-size:24px;color:#019546&quot;&gt;→ Keep a second model&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#f0f8f0;strokeColor=#019546;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="420" height="160" as="geometry"/></mxCell><mxCell id="r" value="&lt;b&gt;Buyers&lt;/b&gt;&lt;br&gt;Same work, for less&lt;br&gt;&lt;b&gt;&lt;span style=&quot;font-size:24px;color:#019546&quot;&gt;→ Sell outcomes, not hours&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#f0f8f0;strokeColor=#019546;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="420" height="160" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=none;html=1;strokeColor=#2D6E2A;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="t" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=none;html=1;strokeColor=#2D6E2A;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;strokeColor=#2D6E2A;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="l" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=none;html=1;strokeColor=#2D6E2A;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="r" target="c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>