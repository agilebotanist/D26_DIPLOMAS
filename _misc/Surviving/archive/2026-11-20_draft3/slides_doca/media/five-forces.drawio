<mxfile host="app.diagrams.net"><diagram name="five-forces" id="five-forces"><mxGraphModel dx="1400" dy="700" grid="0" page="0" pageWidth="1400" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value='&lt;b&gt;New entrants&lt;/b&gt;&lt;br&gt;Easy to build, so everyone builds&lt;br&gt;&lt;i&gt;&lt;span style="font-size:23px;color:#475569"&gt;App builder Lovable: $400M revenue, 146 staff&lt;/span&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#F2F2FF;strokeColor=#0000FF;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="540" height="130" as="geometry"/></mxCell><mxCell id="c" value='&lt;b&gt;Rivalry&lt;/b&gt;&lt;br&gt;New rivals push incumbents down&lt;br&gt;&lt;i&gt;&lt;span style="font-size:23px;color:#475569"&gt;IBM shares −13% on an Anthropic COBOL post&lt;/span&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#F2F2FF;strokeColor=#0000FF;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="470" y="175" width="540" height="140" as="geometry"/></mxCell><mxCell id="b" value='&lt;b&gt;Substitutes&lt;/b&gt;&lt;br&gt;Why buy it if we can build it?&lt;br&gt;&lt;i&gt;&lt;span style="font-size:23px;color:#475569"&gt;Cloudflare rebuilt Next.js in a week&lt;/span&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#F2F2FF;strokeColor=#0000FF;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="470" y="360" width="540" height="130" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;Suppliers&lt;/b&gt;&lt;br&gt;Two labs, and they sell apps too&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:23px;color:#475569&quot;&gt;Anthropic's top model: off for 19 days&lt;/span&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#F2F2FF;strokeColor=#0000FF;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="420" height="160" as="geometry"/></mxCell><mxCell id="r" value="&lt;b&gt;Buyers&lt;/b&gt;&lt;br&gt;Same work, for less&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:23px;color:#E6E6FF&quot;&gt;Persistent's clients: 25–30% off&lt;/span&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma,Verdana,DejaVu Sans,sans-serif;fontSize=28;strokeWidth=2;spacing=10;fillColor=#0000FF;strokeColor=#00008B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="420" height="160" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=none;html=1;strokeColor=#00008B;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="t" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=none;html=1;strokeColor=#00008B;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;strokeColor=#00008B;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="l" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=none;html=1;strokeColor=#00008B;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="r" target="c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>